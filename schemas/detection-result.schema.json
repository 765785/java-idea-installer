{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://765785.github.io/java-idea-installer/schemas/detection-result.schema.json",
  "title": "Java 一键搭建检测结果",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "os", "components", "health", "summary"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "toolVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "os": {
      "type": "object",
      "required": ["family", "version", "architecture"],
      "properties": {
        "family": {
          "enum": ["windows", "macos", "unsupported"]
        },
        "version": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["ok", "partial", "unavailable"]
        },
        "mirrorMode": {
          "enum": ["auto", "always", "never"]
        },
        "selectedMirror": {
          "type": "string"
        },
        "ideaVersionCheck": {
          "enum": ["ok", "unavailable"]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "required": ["jdk", "idea", "javaHome"],
      "properties": {
        "jdk": {
          "$ref": "#/$defs/jdkComponent"
        },
        "idea": {
          "$ref": "#/$defs/ideaComponent"
        },
        "javaHome": {
          "$ref": "#/$defs/javaHomeComponent"
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "fixable"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": ["info", "warning", "error"]
          },
          "fixable": {
            "type": "boolean"
          },
          "action": {
            "type": ["string", "null"]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["ok", "warnings", "errors"],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "jdkComponent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ok", "missing", "outdated", "error"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "targetVersion": {
          "type": "integer"
        },
        "source": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "ideaComponent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ok", "missing", "outdated", "error", "unknown"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "latestVersion": {
          "type": ["string", "null"]
        },
        "build": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "javaHomeComponent": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ok", "missing", "invalid", "mismatch"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "message": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
