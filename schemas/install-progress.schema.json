{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://765785.github.io/java-idea-installer/schemas/install-progress.schema.json",
  "title": "Java 一键搭建安装进度",
  "type": "object",
  "required": ["schemaVersion", "action", "status", "currentStep", "totalSteps", "percent", "steps", "startedAt", "updatedAt", "message"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "action": {
      "enum": ["install", "uninstall", "fix", "verify"]
    },
    "status": {
      "enum": ["running", "success", "partial", "failed"]
    },
    "currentStep": {
      "type": "integer",
      "minimum": 0
    },
    "totalSteps": {
      "type": "integer",
      "minimum": 1
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": ["pending", "running", "complete", "failed"]
          },
          "estimatedSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": ["object", "null"]
    },
    "log": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
